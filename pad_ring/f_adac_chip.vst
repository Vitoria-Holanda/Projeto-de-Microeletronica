      ck   => ck_ring,
      vdde => vdde,
      vddi => vdd,
      vsse => vsse,
      vssi => vss
   );

p_sel0 : pi_sp
   Generic Map (
      area      => 86000,
      cin_pad   => 654,
      tpll_pad  => 1487,
      rdown_pad => 234,
      tphh_pad  => 233,

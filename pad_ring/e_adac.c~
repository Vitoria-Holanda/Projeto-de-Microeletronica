#include <genlib.h>
#define POWER "vdde","vdd","vsse","vss", NULL

int main(void){
    int i;
    
    // 1. Define o nome do arquivo final do chip completo
    GENLIB_DEF_LOFIG("f_adac_chip");

    // 2. Declaração dos pinos externos do chip (visíveis de fora)
    GENLIB_LOCON("a[3:0]", IN, "a[3:0]"); 
    GENLIB_LOCON("s[3:0]", OUT, "s[3:0]");
    GENLIB_LOCON("sel0", IN, "sel0");
    GENLIB_LOCON("sel1", IN, "sel1");
    GENLIB_LOCON("cin", IN, "cin");
    GENLIB_LOCON("cout", OUT, "cout");
    GENLIB_LOCON("clk", IN, "clk");
    
    // Pinos de alimentação padronizados do anel
    GENLIB_LOCON("vdd", IN, "vdd"); 
    GENLIB_LOCON("vss", IN, "vss");
    GENLIB_LOCON("vdde", IN, "vdde"); 
    GENLIB_LOCON("vsse", IN, "vsse");

    // 3. Instanciação do seu núcleo (o arquivo g_adac_4_boog.vst)
    // Conecta as portas da entidade aos sinais internos (com 'i' no final)
    GENLIB_LOINSE("a_adac_core", "core",
        "vdd => vdd",
        "vss => vss",
        "a[3:0] => ai[3:0]",
        "sel0 => sel0i",
        "sel1 => sel1i",
        "cin => cini",
        "clk => cki", // O pad de clock transforma 'clk' externo em 'cki' interno
        "s[3:0] => si[3:0]",
        "cout => couti", 
        NULL);

    // 4. Instanciação dos Pads usando as células do padlib
    // Loop para instanciar os 4 pads de entrada de A e os 4 de saída de S
    for(i=0; i<4; i++){
        GENLIB_LOINS("pi_sp", GENLIB_NAME("p_a%d",i), GENLIB_ELM("a",i), GENLIB_ELM("ai",i), "cki", POWER);
        GENLIB_LOINS("po_sp", GENLIB_NAME("p_s%d",i), GENLIB_ELM("si",i), GENLIB_ELM("s",i), "cki", POWER);
    }

    // Pads individuais de entrada (pi_sp)
    GENLIB_LOINS("pi_sp", "p_sel0", "sel0", "sel0i", "cki", POWER);
    GENLIB_LOINS("pi_sp", "p_sel1", "sel1", "sel1i", "cki", POWER);
    GENLIB_LOINS("pi_sp", "p_cin", "cin", "cini", "cki", POWER);

    // Pad individual de saída (po_sp)
    GENLIB_LOINS("po_sp", "p_cout", "couti", "cout", "cki", POWER);

    // Pads de alimentação e clock (elementos padrão do anel)
    GENLIB_LOINS("pvddick_sp", "p_vddick0", "ckc", "cki", POWER);
    GENLIB_LOINS("pvssick_sp", "p_vssick0", "ckc", "cki", POWER);
    GENLIB_LOINS("pvddeck_sp", "p_vddeck0", "ckc", "cki", POWER);
    GENLIB_LOINS("pvsseck_sp", "p_vsseck0", "ckc", "cki", POWER);
    GENLIB_LOINS("pck_sp", "p_ck", "clk", "cki", POWER);

    // Salva a figura lógica final
    GENLIB_SAVE_LOFIG();
    return 0;
}

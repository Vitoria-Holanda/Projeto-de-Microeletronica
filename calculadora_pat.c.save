#include <stdio.h>
#include "genpat.h"

int main (){
	DEF_GENPAT("calculadora");

	DECLAR("clk", ":2", "B", " ", "");
	DECLAR("sel0", ":2", "B", " ", "");
	DECLAR("sel1", ":2", "B", " ", "");
	DELCAR("a", ":2", "X", "3 downto 0", "");

	DECLAR("s", ":2", "X", "3 downto 0", "");
	DECLAR("cout", ":2", "B", " ", "");

	A_SAV();

}
